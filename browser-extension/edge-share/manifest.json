{
  "manifest_version": 3,
  "name": "Browser Connection Share",
  "version": "0.1.1",
  "description": "Share this browser with browser-connection through a relay link.",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Browser Share",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "provider.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://* https://* ws://* wss://*;"
  }
}
